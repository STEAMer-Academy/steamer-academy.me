{
  "name": "next-app-steamer",
  "version": "4.1.1",
  "private": true,
  "scripts": {
    "prebuild": "cn build --content \"src/{app,components,lib}/**/*.{ts,tsx}\" -o src/lib/cn-tables.ts",
    "predev": "cn build --content \"src/{app,components,lib}/**/*.{ts,tsx}\" -o src/lib/cn-tables.ts",
    "dev": "next dev",
    "build": "bun run partytown && bun run build-index && next build",
    "build-index": "bun run scripts/build-search-index.ts",
    "start": "next start",
    "lint": "eslint .",
    "partytown": "partytown copylib public/~partytown",
    "fmt": "prettier --check --write .",
    "typecheck": "tsc --noEmit",
    "seed": "bun run scripts/seed-redis.ts",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@arcjet/next": "^1.14.1",
