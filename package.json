    "dotenv": "^18.0.7",
    "dotted-map": "^3.1.0",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-prettier": "^5.5.6",
    "framer-motion": "^14.1.0",
    "hugeicons-react": "^0.4.0",
    "lru-cache": "^11.5.3",
